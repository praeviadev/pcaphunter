    {
      "id": "smartapesg-001",
      "name": "SmartApeSG Script Injection",
      "description": "Detects injection of SmartApeSG malicious scripts into web pages from compromised websites.",
      "log_type": "http",
      "enabled": true,
      "severity": "high",
      "logic": {
        "type": "substring_match",
        "field": "http.response.body",
        "values": [
          "SmartApeSG script injected"
        ]
      },
      "tags": [
        "malware",
        "script-injection",
        "smartapesg"
      ],
      "references": [
        "https://www.malware-traffic-analysis.net/2026/04/06/index.html"
      ],
      "source_url": "https://www.malware-traffic-analysis.net/2026/04/06/index.html",
      "original_field": "http.response.body",
      "warnings": [
        "unverified field for http: http.response.body"
      ]
    },
    {
      "id": "smartapesg-002",
